# Copy to .env and fill in real values.  NEVER commit the real .env.
#   cp .env.example .env

# REQUIRED. Any long random string, e.g. generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/esg_brsr

# JWT / auth behaviour
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - the Vite dev server origin
CORS_ORIGINS=["http://localhost:5173"]

# Uploads (evidence attachments, not yet implemented)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
